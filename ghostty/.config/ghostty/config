theme = gruvbox-dark-hard

shell-integration = fish

macos-titlebar-style = tabs

window-padding-x = 10,10
window-padding-y = 10,0
window-padding-balance = true

window-height = 47
window-width = 206

font-family = Berkeley Mono
font-style = SemiLight ExtraCondensed
font-style-bold = Medium ExtraCondensed
font-style-italic = SemiLight ExtraCondensed Oblique
font-style-bold-italic = Medium ExtraCondensed Oblique
font-size = 20.0

# Kitty graphics protocol image storage per screen, in bytes (0 disables images)
image-storage-limit = 320000000

keybind = alt+backspace=text:\x1b\x7f
